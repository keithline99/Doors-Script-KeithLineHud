-- ==========================================
local autoHighActive = false
local currentHighlightColor = availableColors[1].Color
local activeHighlights = {}
local highLoop = nil

colorBtn.MouseButton1Click:Connect(function()
	currentColorIndex = currentColorIndex % #availableColors + 1
	local selected = availableColors[currentColorIndex]
	currentHighlightColor = selected.Color
	colorBtn.Text = "Highlight Color: " .. selected.Name

	for _, hl in pairs(activeHighlights) do
		if hl and hl.Parent then
			hl.FillColor = currentHighlightColor
		end
	end
end)

local function getTargetParentModel(model)
	local current = model.Parent
	while current and current ~= Workspace do
		if current:IsA("Model") then return current end
		current = current.Parent
	end
	return model
end

local function updateHighlighters()
	if not autoHighActive then return end

	local validTargets = {}

	local function searchRecursive(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child.Name == "DrawerContainer" then
				if drawerHighlightEnabled then
					validTargets[child] = true
				end
				if parentHighlightEnabled then
					local parentModel = getTargetParentModel(child)
					if parentModel then
						validTargets[parentModel] = true
					end
				end
			end
			if #child:GetChildren() > 0 then
				searchRecursive(child)
			end
		end
	end

	searchRecursive(Workspace)

	for target, _ in pairs(validTargets) do
		if not activeHighlights[target] or not activeHighlights[target].Parent then
			local hl = Instance.new("Highlight")
			hl.Name = "KeithLineVisualHighlighter"
			hl.Adornee = target
			hl.FillColor = currentHighlightColor
			hl.FillTransparency = 0.4
			hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			hl.OutlineTransparency = 0.1
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = target

			activeHighlights[target] = hl
		end
	end

	for target, hl in pairs(activeHighlights) do
		if not validTargets[target] or not target.Parent or not target:IsDescendantOf(Workspace) then
			if hl and hl.Parent then
				hl:Destroy()
			end
			activeHighlights[target] = nil
		end
	end
end

local function removeAllHighlighters()
	for target, hl in pairs(activeHighlights) do
		if hl and hl.Parent then
			hl:Destroy()
		end
	end
	activeHighlights = {}
end

highToggleBtn.MouseButton1Click:Connect(function()
	autoHighActive = not autoHighActive

	if autoHighActive then
		highToggleBtn.Text = "ON"
		highToggleBtn.BackgroundColor3 = Color3.fromRGB(58, 134, 255)
		highToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sendNotification("Highlighter", "Visual Highlighter activated.", 2.5)

		highLoop = RunService.Heartbeat:Connect(function()
			updateHighlighters()
		end)
	else
		highToggleBtn.Text = "OFF"
		highToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		highToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
		sendNotification("Highlighter", "Visual Highlighter disabled.", 2.5)

		if highLoop then
			highLoop:Disconnect()
			highLoop = nil
		end
		removeAllHighlighters()
	end
end)

removeAllHighBtn.MouseButton1Click:Connect(function()
	removeAllHighlighters()
	sendNotification("Highlighter", "All highlights cleared.", 2)
end)


