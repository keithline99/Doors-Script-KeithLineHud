-- ==========================================
-- ЛОГИКА AUTO DRAWER OPENER
-- ==========================================
local autoOpenerActive = false
local activationDistance = 8
local processedDrawers = {}
local detectedDrawersMap = {}
local openerLoop = nil

local function updateOpenerStats()
	local detectedCount = 0
	local openedCount = 0

	for drawer, _ in pairs(detectedDrawersMap) do
		if drawer and drawer.Parent and drawer:IsDescendantOf(Workspace) then
			detectedCount += 1
			if processedDrawers[drawer] then
				openedCount += 1
			end
		else
			detectedDrawersMap[drawer] = nil
			processedDrawers[drawer] = nil
		end
	end

	local remainingCount = math.max(0, detectedCount - openedCount)
	detectedLbl.Text = "Detected Drawers: " .. tostring(detectedCount)
	openedLbl.Text = "Opened Drawers: " .. tostring(openedCount)
	remainingLbl.Text = "Remaining Drawers: " .. tostring(remainingCount)
end

local function triggerDrawerInteraction(drawerContainer)
	if processedDrawers[drawerContainer] then return end

	local triggered = false
	for _, desc in ipairs(drawerContainer:GetDescendants()) do
		if desc.Name == "ActivateEventPrompt" or desc:IsA("ProximityPrompt") then
			if desc:IsA("ProximityPrompt") then
				desc.RequiresLineOfSight = false
				fireproximityprompt(desc)
				triggered = true
			elseif desc:IsA("RemoteEvent") then
				desc:FireServer()
				triggered = true
			elseif desc:IsA("BindableEvent") then
				desc:Fire()
				triggered = true
			end
		end
	end

	if triggered then
		processedDrawers[drawerContainer] = true
		updateOpenerStats()
	end
end

local function getDrawerPosition(drawerContainer)
	if drawerContainer:IsA("Model") then
		local primary = drawerContainer.PrimaryPart
		if primary then return primary.Position end
		local part = drawerContainer:FindFirstChildWhichIsA("BasePart")
		if part then return part.Position end
	elseif drawerContainer:IsA("BasePart") then
		return drawerContainer.Position
	end
	return nil
end

local function scanAndCheckProximity()
	if not autoOpenerActive then return end

	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if not rootPart then return end

	local function searchRecursive(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child.Name == "DrawerContainer" then
				detectedDrawersMap[child] = true

				if not processedDrawers[child] then
					local pos = getDrawerPosition(child)
					if pos then
						local distance = (rootPart.Position - pos).Magnitude
						if distance <= activationDistance then
							triggerDrawerInteraction(child)
						end
					end
				end
			end
			if #child:GetChildren() > 0 then
				searchRecursive(child)
			end
		end
	end

	searchRecursive(Workspace)
	updateOpenerStats()
end

openerToggleBtn.MouseButton1Click:Connect(function()
	autoOpenerActive = not autoOpenerActive

	if autoOpenerActive then
		openerToggleBtn.Text = "ON"
		openerToggleBtn.BackgroundColor3 = Color3.fromRGB(58, 134, 255)
