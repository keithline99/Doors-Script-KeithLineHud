-- УПРАВЛЕНИЕ ИНТЕРФЕЙСОМ И КУРСОРОМ (RightShift Toggle)
-- ==========================================
toggleGUI = function()
	isOpen = not isOpen

	if isOpen then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 720, 0, 540)
		mainFrame.BackgroundTransparency = 1
		TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 780, 0, 600),
			BackgroundTransparency = 0
		}):Play()

		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	else
		local tweenOut = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 720, 0, 540),
			BackgroundTransparency = 1
		})
		tweenOut:Play()
		tweenOut.Completed:Connect(function()
			if not isOpen then mainFrame.Visible = false end
		end)

		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.RightShift then
		toggleGUI()
	end
end)

