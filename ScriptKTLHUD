-- ЛОГИКА ПОДСВЕТКИ ДВЕРЕЙ
-- ==========================================
local autoHighlightDoorsActive = false
local currentDoorColor = doorColors[1].Color
local activeDoorHighlights = {}
local doorLoop = nil

doorColorBtn.MouseButton1Click:Connect(function()
	doorColorIndex = doorColorIndex % #doorColors + 1
	local selected = doorColors[doorColorIndex]
	currentDoorColor = selected.Color
	doorColorBtn.Text = "Highlight Color: " .. selected.Name

	for _, hl in pairs(activeDoorHighlights) do
		if hl and hl.Parent then
			hl.FillColor = currentDoorColor
		end
	end
end)

local function updateDoorHighlighter()
	if not autoHighlightDoorsActive then return end

	local foundDoors = {}

	local function searchDoorsRecursive(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child.Name == "Door" and child:IsA("Model") then
				local isOpened = child:GetAttribute("Opened")
				if not isOpened then
					foundDoors[child] = true
				end
			end
			if #child:GetChildren() > 0 then
				searchDoorsRecursive(child)
			end
		end
	end

	searchDoorsRecursive(Workspace)

	local currentRoomsFolder = Workspace:FindFirstChild("CurrentRooms")
	if currentRoomsFolder then
		searchDoorsRecursive(currentRoomsFolder)
	end

	local count = 0
	for doorModel, _ in pairs(foundDoors) do
		count += 1

		if not activeDoorHighlights[doorModel] or not activeDoorHighlights[doorModel].Parent then
			local hl = Instance.new("Highlight")
			hl.Name = "KeithLineDoorHighlight"
			hl.Adornee = doorModel
			hl.FillColor = currentDoorColor
			hl.FillTransparency = 0.4
			hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			hl.OutlineTransparency = 0.1
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = doorModel

			activeDoorHighlights[doorModel] = hl

			doorModel:GetAttributeChangedSignal("Opened"):Connect(function()
				if doorModel:GetAttribute("Opened") == true then
					if activeDoorHighlights[doorModel] then
						activeDoorHighlights[doorModel]:Destroy()
						activeDoorHighlights[doorModel] = nil
					end
				end
			end)
		end
	end

	for doorModel, hl in pairs(activeDoorHighlights) do
		if not foundDoors[doorModel] or not doorModel.Parent or not doorModel:IsDescendantOf(Workspace) or doorModel:GetAttribute("Opened") == true then
			if hl and hl.Parent then
				hl:Destroy()
			end
			activeDoorHighlights[doorModel] = nil
		end
	end

	detectedDoorsLbl.Text = "Active Doors Highlighted: " .. tostring(count)
end

local function removeAllDoorHighlights()
	for _, hl in pairs(activeDoorHighlights) do
		if hl and hl.Parent then
			hl:Destroy()
		end
	end
	activeDoorHighlights = {}
	detectedDoorsLbl.Text = "Active Doors Highlighted: 0"
end

highDoorBtn.MouseButton1Click:Connect(function()
	autoHighlightDoorsActive = not autoHighlightDoorsActive

	if autoHighlightDoorsActive then
		highDoorBtn.Text = "ON"
		highDoorBtn.BackgroundColor3 = Color3.fromRGB(58, 134, 255)
		highDoorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sendNotification("Door Highlighter", "Independent Door Highlighting enabled.", 2.5)

		doorLoop = RunService.Heartbeat:Connect(function()
			updateDoorHighlighter()
		end)
	else
		highDoorBtn.Text = "OFF"
		highDoorBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		highDoorBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
		sendNotification("Door Highlighter", "Door Highlighting disabled.", 2.5)

		if doorLoop then
			doorLoop:Disconnect()
			doorLoop = nil
		end
		removeAllDoorHighlights()
	end
end)

