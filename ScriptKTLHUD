-- ==========================================
local speedActive = false
local speedValue = 50
local speedWarningShown = false
local speedLoop = nil

speedBox.FocusLost:Connect(function()
	local num = tonumber(speedBox.Text)
	if num then
		speedValue = math.clamp(num, 16, 100)
	end
	speedBox.Text = tostring(speedValue)
end)

local function applySpeedhack()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if speedValue > 40 and not speedWarningShown then
		speedWarningShown = true
		sendNotification("Speedhack", "Speed > 40: rooms may load slowly (stucks)!", 4)
	end

	if hum.WalkSpeed ~= speedValue then
		hum.WalkSpeed = speedValue
	end
end

speedToggleBtn.MouseButton1Click:Connect(function()
	speedActive = not speedActive

	if speedActive then
		speedToggleBtn.Text = "ON"
		speedToggleBtn.BackgroundColor3 = Color3.fromRGB(58, 134, 255)
		speedToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sendNotification("Speedhack", "Speedhack enabled.", 2.5)

		speedLoop = RunService.Heartbeat:Connect(applySpeedhack)
	else
		speedToggleBtn.Text = "OFF"
		speedToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		speedToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
		sendNotification("Speedhack", "Speedhack disabled.", 2.5)

		if speedLoop then
			speedLoop:Disconnect()
			speedLoop = nil
		end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	end
end)


